# ============================================================================
# SphereTickets — environment configuration (Vite + Unicity Sphere SDK)
# Copy this file to `.env` and fill the values. NEVER commit a real .env.
# ============================================================================

# --- Unicity network --------------------------------------------------------
# Use 'testnet' (alias of testnet2, networkId 4) for development.
# mainnet/dev gateways are v1-era and cannot serve the v2 token engine yet.
VITE_SPHERE_NETWORK=testnet

# Public testnet2 gateway API key (NOT a secret — published in sphere-sdk .env.example).
# A mainnet key WOULD be a secret; keep it server-side only.
VITE_SPHERE_ORACLE_API_KEY=sk_testnet2_public

# wallet-api backend (delivery + token storage). testnet2 deployment:
VITE_WALLET_API_BASE_URL=https://wallet-api.unicity.network

# Gateway (token engine) URL for testnet2:
VITE_SPHERE_GATEWAY_URL=https://gateway.testnet2.unicity.network

# --- Wallet host (for Connect protocol popup / iframe) -----------------------
VITE_SPHERE_WALLET_URL=https://sphere.unicity.network

# --- Ticket metadata storage (Opsi A: shared indexer) ----------------------
# V1 keeps event+ticket metadata off-chain (the token engine has no NFT metadata
# field). Set this to a SHARED indexer URL so events are visible to ALL users.
# - "/api"  -> use the bundled Vite proxy + `node indexer/server.mjs` (dev, simple)
# - https://your-indexer.example.com -> a deployed backend (production)
# - empty   -> per-device localStorage (events only visible in THIS browser)
VITE_METADATA_INDEXER_URL=/api

# --- Stablecoin / payment coin (optional override) ---------------------------
# Defaults to the network's native fungible coin if empty.
VITE_PAYMENT_COIN_ID=
